---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const albums = (await getCollection('albums')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Photos" wide>
  <h1>Photos</h1>
  <ul class="albums">
    {albums.map((a) => (
      <li>
        <a href={`/${a.id}`}>
          <img src={a.data.cover || a.data.photos[0]?.thumb || a.data.photos[0]?.src} alt="" width="400" height="300" loading="lazy" />
          {a.data.title}
        </a>
      </li>
    ))}
  </ul>
</Base>
